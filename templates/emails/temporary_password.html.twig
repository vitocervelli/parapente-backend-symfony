{% extends 'emails/base.html.twig' %}

{% block title %}Tu acceso a Parapente Bella Vista{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#1f2933;">Ya tienes cuenta con nosotros</h1>
    <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
        Hola{% if user.fullName %} {{ user.fullName }}{% endif %}, hemos creado una cuenta para ti
        en <strong>Parapente Bella Vista</strong> con tu reserva. Puedes entrar con estos datos:
    </p>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;">
        <tr>
            <td style="padding:8px 0;color:#7b8794;font-size:13px;">Correo</td>
            <td style="padding:8px 0;text-align:right;font-weight:bold;font-size:14px;">{{ user.email }}</td>
        </tr>
        <tr>
            <td style="padding:8px 0;border-top:1px solid #eef1f4;color:#7b8794;font-size:13px;">Contraseña temporal</td>
            <td style="padding:8px 0;border-top:1px solid #eef1f4;text-align:right;font-weight:bold;font-size:18px;letter-spacing:1px;font-family:monospace;">{{ password }}</td>
        </tr>
    </table>
    <p style="margin:0 0 8px;font-size:15px;line-height:1.6;">
        Por seguridad, entra en tu perfil y <strong>cámbiala cuanto antes</strong>:
    </p>
    <p style="margin:24px 0;">
        <a href="{{ url }}" style="display:inline-block;background:#0b3d91;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:bold;font-size:15px;">Entrar y cambiar mi contraseña</a>
    </p>
{% endblock %}
