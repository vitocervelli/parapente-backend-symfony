{% extends 'emails/base.html.twig' %}

{% block title %}Recupera tu contraseña{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px;font-size:22px;color:#1f2933;">Recupera tu contraseña</h1>
    <p style="margin:0 0 16px;font-size:15px;line-height:1.6;">
        Hola{% if user.fullName %} {{ user.fullName }}{% endif %}, recibimos una solicitud para
        restablecer la contraseña de tu cuenta en <strong>Parapente Bella Vista</strong>.
    </p>
    <p style="margin:0 0 8px;font-size:15px;line-height:1.6;">
        Pulsa el botón para elegir una nueva contraseña:
    </p>
    <p style="margin:24px 0;">
        <a href="{{ url }}" style="display:inline-block;background:#0b3d91;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-weight:bold;font-size:15px;">Cambiar mi contraseña</a>
    </p>
    <p style="margin:0 0 8px;font-size:14px;color:#7b8794;line-height:1.6;">
        Este enlace caduca en 1 hora. Si no has sido tú, puedes ignorar este correo: tu
        contraseña actual seguirá funcionando.
    </p>
{% endblock %}
